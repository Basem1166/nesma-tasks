# ---------------------------------------------------------------------------
# Nesma server configuration. Copy to `.env` and fill in. NEVER commit `.env`.
# See docs/SECURITY.md for how each secret is used and how to rotate it.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# Database. SQLite file for dev; use a postgresql:// URL in production
# (and switch the provider in prisma/schema.prisma).
DATABASE_URL="file:./dev.db"

# Comma-separated list of browser origins allowed to call the API.
# Empty = http://localhost:5173 (or the Render URL when deployed on Render).
CORS_ORIGINS=
# Public URL of the web app - used for links inside emails. Same default.
APP_URL=

# JWT signing secrets - generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# --- Email (SMTP). Leave SMTP_HOST empty to run in "log" mode: emails are
# rendered and stored in the EmailLog table (visible under Admin > Email outbox)
# but not delivered.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Nesma Tasks <no-reply@nesma.local>"

# --- AI. Without a key the app still runs; the assistant reports that AI is
# not configured and reports fall back to a rule-based narrative.
#
# FREE option (default): Google Gemini. Get a key (no credit card) at
#   https://aistudio.google.com/apikey  and paste it into AI_API_KEY.
# Note: on Gemini's free tier Google may use prompts to improve its products -
# fine for demo data, use a paid key for real company data.
AI_PROVIDER=gemini
AI_API_KEY=
# gemini-3.5-flash-lite has the most generous free quota; gemini-3.8-flash is
# smarter but allows far fewer requests per day on the free tier.
AI_MODEL=gemini-3.5-flash-lite
# Other OpenAI-compatible services also work with AI_PROVIDER=openai, e.g. Groq:
#   AI_BASE_URL=https://api.groq.com/openai/v1   AI_MODEL=<a Groq tool-calling model>
AI_BASE_URL=
#
# Paid option: Claude. Set AI_PROVIDER=anthropic and:
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# --- Push notifications (Expo). Optional access token if you enabled
# "enhanced push security" in your Expo account.
EXPO_ACCESS_TOKEN=

# --- Automation schedule (cron syntax, server local time).
# How often deadline/overdue checks run.
CRON_DEADLINE_CHECK="*/10 * * * *"
# Monthly AI report: 07:00 on the 1st of every month (covers the previous month).
CRON_MONTHLY_REPORT="0 7 1 * *"
# Hours before the due date that the "deadline approaching" reminder fires.
REMINDER_WINDOW_HOURS=24
